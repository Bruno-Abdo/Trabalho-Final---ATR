#pragma once

#include <string>
#include <string_view>

static constexpr std::string_view project_name = "@PROJECT_NAME@";
static constexpr std::string_view project_version = "@PROJECT_VERSION@";

// --- MQTT Configuration ---
#define MQTT_URL "mqtt://mosquitto:1883"
#define MQTT_CLIENT_ID "truck_001_embedded"
#define TRUCK_ID "001"
#define MQTT_TOPIC_ACTUATORS "atr/truck/001/actuators"
#define MQTT_TOPIC_SENSORS "atr/truck/001/sensors"
#define MQTT_TOPIC_ROUTE "atr/truck/001/route"
#define MQTT_TOPIC_INTERFACE "atr/truck/001/interface"
#define MQTT_DEFAULT_QOS 1
#define MQTT_DEFAULT_TIME_OUT_MS 10000
// #define DEFAULT_WAYPOINT_TOLERANCE 2.0
// #define ROUTE_MQTT_CONSUME_TIMEOUT_MS 100 // Timeout balanceado
// --- Task IDs and Periods ---
#define ID_LOGICA 0
#define ID_MONITORAMENTO 1
#define ID_PLANEJAMENTO 2
#define ID_CONTROLE 3
#define ID_COLETOR 4
#define ID_TRATAMENTO 5
#define ID_COMANDO 6

#define SLEEP_MS_LOGICA 6000
#define SLEEP_MS_MONITORAMENTO 100
#define SLEEP_MS_PLANEJAMENTO 100
#define SLEEP_MS_CONTROLE 50
#define SLEEP_MS_COLETOR 200
#define SLEEP_MS_TRATAMENTO 50
#define SLEEP_MS_COMANDO 50

// --- Buffer Configuration ---
#define BUFF_CONSUMIDORES 5
#define BUFF_CAPACIDADE 200

// --- Filter Configuration ---
#define FILTER_ORDER_M 10

#define CSV_OUTPUT_FILE "truck_data.csv"
#define CSV_ENABLE_HEADER true

#define INFLUXDB_ENABLED false

// --- BufferData Structure ---
struct BufferData
{
    // --- Identificação e Timestamp ---
    std::string truck_id;
    double timestamp;

    // --- Dados dos Sensores (Tabela 1 - Valores TRATADOS após filtro) ---
    int i_posicao_x;   // Posição X filtrada
    int i_posicao_y;   // Posição Y filtrada
    int i_angulo_x;    // Ângulo filtrado
    int i_temperatura; // Temperatura filtrada

    // --- Dados de Falha (Booleanos não são filtrados) ---
    bool i_falha_eletrica;
    bool i_falha_hidraulica;

    // --- Estados da Lógica de Comando (Tabela 2) ---
    bool e_defeito;
    bool e_automatico;

    // --- Setpoints de Navegação ---
    double setpoint_velocidade;
    double setpoint_angulo;

    // Construtor padrão para inicialização
    BufferData()
        : truck_id("001"),
          timestamp(0.0),
          i_posicao_x(0),
          i_posicao_y(0),
          i_angulo_x(0),
          i_temperatura(0),
          i_falha_eletrica(false),
          i_falha_hidraulica(false),
          e_defeito(false),
          e_automatico(false),
          setpoint_velocidade(0.0),
          setpoint_angulo(0.0)
    {
    }
};
