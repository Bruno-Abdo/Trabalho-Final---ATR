{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CMake (Debug)",
            "type": "shell",
            "command": "cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rm -rf build",
            "problemMatcher": []
        },
        {
            "label": "Compile (Debug)",
            "type": "shell",
            "command": "cmake --build build -j4",
            "dependsOn": "Build CMake (Debug)",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run (Debug)",
            "type": "shell",
            "command": "./build/project_output/atr",
            "dependsOn": "Compile (Debug)",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}